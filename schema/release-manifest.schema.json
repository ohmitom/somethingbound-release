{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ohmitom/somethingbound-release/blob/main/schema/release-manifest.schema.json",
  "title": "SomethingBound release manifest",
  "description": "Public, signed-out-of-band release metadata consumed by release tooling and launchers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestSchemaVersion",
    "release",
    "versions",
    "minimumCompatibleVersions",
    "artifacts"
  ],
  "properties": {
    "manifestSchemaVersion": {
      "const": 1,
      "description": "Version of this manifest contract, not the product release version."
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "gitSha",
        "buildTimestamp",
        "releaseNotes",
        "previousRelease",
        "rollbackTarget"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver",
          "description": "Human-facing product release version."
        },
        "gitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full lowercase Git SHA-1 for the source used to build this release."
        },
        "buildTimestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
          "description": "UTC RFC 3339 build time."
        },
        "releaseNotes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["range", "text"],
          "properties": {
            "range": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {
                "from": {
                  "anyOf": [
                    { "type": "null" },
                    { "$ref": "#/$defs/semver" }
                  ]
                },
                "to": { "$ref": "#/$defs/semver" }
              }
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "description": "Release notes or a concise public summary."
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "Optional public page containing the same release notes."
            }
          }
        },
        "previousRelease": {
          "description": "The manifest anchor used to establish the release-note range; null for the first release.",
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/releaseReference" }
          ]
        },
        "rollbackTarget": {
          "description": "The last known-good release to use if this promotion is rolled back; null only when none exists.",
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/releaseReference" }
          ]
        }
      }
    },
    "versions": {
      "$ref": "#/$defs/versionSet",
      "description": "Versions produced or coordinated by this release."
    },
    "minimumCompatibleVersions": {
      "$ref": "#/$defs/versionSet",
      "description": "Lowest versions that this release is declared compatible with."
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client", "server"],
      "properties": {
        "client": { "$ref": "#/$defs/artifact" },
        "server": { "$ref": "#/$defs/artifact" }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "description": "Semantic Versioning 2.0.0 value."
    },
    "versionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client", "server", "protocol", "content", "ruleset", "schema"],
      "properties": {
        "client": { "$ref": "#/$defs/semver" },
        "server": { "$ref": "#/$defs/semver" },
        "protocol": { "$ref": "#/$defs/semver" },
        "content": { "$ref": "#/$defs/semver" },
        "ruleset": { "$ref": "#/$defs/semver" },
        "schema": { "$ref": "#/$defs/semver" }
      }
    },
    "releaseReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "manifestUrl"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "manifestUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "sizeBytes"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "HTTPS URL for the artifact; credentials are not permitted."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
