{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ohmitom/somethingbound-release/blob/main/schema/release-manifest.schema.json",
  "title": "SomethingBound release-channel manifest",
  "description": "The local-first launcher release channel contract. The top-level identity fields are intentionally exactly channel, version, gitSha, releasedAt, notes, and artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "channel",
    "version",
    "gitSha",
    "releasedAt",
    "notes",
    "artifacts"
  ],
  "properties": {
    "channel": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Named release channel, for example local-dev, beta, or stable."
    },
    "version": {
      "$ref": "#/$defs/semver",
      "description": "The launcher/product version for this channel release."
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Full lowercase Git SHA for the running build identity."
    },
    "releasedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "UTC RFC 3339 release timestamp."
    },
    "notes": {
      "$ref": "#/$defs/notes"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "description": "Semantic Versioning 2.0.0 value."
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "commits"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "commits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commit"
          }
        }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "subject", "category", "scope"],
      "properties": {
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full commit SHA; the launcher displays its seven-character short form."
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": ["string", "null"]
        },
        "pr": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 },
            { "type": "string", "minLength": 1 }
          ],
          "description": "Optional pull-request reference, such as 123 or #123."
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "sha256", "size"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\:]+$",
          "description": "Safe file name used for the artifact, not a path."
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "A local path, file URL, or HTTP(S) URL. Development uses local sources."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
